{
  "permissions": {
    "allow": [
      "Bash(uv run:*)",
      "WebSearch",
      "WebFetch(domain:ja.wikipedia.org)",
      "WebFetch(domain:www.jreast.co.jp)",
      "WebFetch(domain:w.atwiki.jp)",
      "WebFetch(domain:google.com)",
      "WebFetch(domain:en.wikipedia.org)",
      "Bash(python:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(uv sync:*)",
      "Bash(find .claude -type f -name *.md -o -name *.yml -o -name *.yaml -o -name *.json)",
      "Bash(grep -r \"skill\\\\|Skill\" --include=*.py --include=*.md .)",
      "Bash(xargs -I {} sh -c \"echo \"\"=== {} ===\"\"; head -10 {}\")",
      "Bash(grep -r Agent --include=*.md --include=*.json --include=*.ts --include=*.js --include=*.py .)",
      "Bash(find . -name \"*.md\" -exec grep -l \"Agent\" {})",
      "Bash(cd:*)",
      "WebFetch(domain:stackoverflow.com)",
      "WebFetch(domain:superuser.com)",
      "WebFetch(domain:www.reddit.com)",
      "PowerShell(uv run *)",
      "Bash(git diff *)",
      "Bash(PYTHONUTF8=1 python validate_data.py)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/.env*)",
      "Write(~/.ssh/**)",
      "Write(~/.aws/**)",
      "Bash(curl * | bash)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(nc *)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(* > /dev/*)"
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true
  },
  "skipWebFetchPreflight": true
}
